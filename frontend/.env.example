# Which adapter backs the UI: "mock" (in-browser, default) or "http" (your backend).
VITE_API_MODE=mock
# Base URL of the backend API, used by src/api/http/httpAdapter.js when VITE_API_MODE=http.
VITE_API_BASE_URL=
# Cognito user pool and app client used for sign-in when VITE_API_MODE=http (public IDs, not secrets).
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# How often tasks and notifications are refetched, in ms.
VITE_POLL_INTERVAL_MS=15000
# How long "Remind me later" hides the deadline reminder, in ms (default 4h).
VITE_REMINDER_SNOOZE_MS=14400000

# Mock adapter only, for local development. Vite embeds VITE_* values in the public bundle:
# these are demo sign-ins, not secrets. Accounts whose password is unset can't sign in.
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=replace-with-a-local-demo-password
VITE_DEMO_MEMBER_PASSWORD=replace-with-a-local-demo-password
VITE_MOCK_LATENCY_MS=150
# Production builds refuse to run on the insecure mock. Set to true only for a throwaway demo.
VITE_ALLOW_MOCK_IN_PRODUCTION=false

# Largest attachment accepted, in MB. The mock keeps files in browser storage, so keep this small.
# http mode allows up to 10 MB
VITE_MAX_ATTACHMENT_MB=1
